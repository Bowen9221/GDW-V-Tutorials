# ====================================================================
# Git Ignore configuration for Unreal Engine
# Ignores build artifacts, user settings, cache files, and logs.
# ====================================================================

# --------------------------------------------------------------------
# Host Operating System Files
# --------------------------------------------------------------------
.DS_Store
Thumbs.db

# --------------------------------------------------------------------
# Unreal Engine Cache, Log, and Build Folders
# --------------------------------------------------------------------
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/

# --------------------------------------------------------------------
# Project Configuration & Local User Files
# --------------------------------------------------------------------
# Ignore local workspace and user layout preferences
.vs/
.vscode/
.idea/
*.sln
*.suo
*.user
*.userosscache
*.sln.docstates

# --------------------------------------------------------------------
# Unreal Engine Built-In Plugin Artifacts
# --------------------------------------------------------------------
# Ignore Bridge (Megascans) background downloads
Plugins/Bridge/

# Ignore automatically downloaded external project dependencies
/*/Binaries/
/*/Intermediate/

# --------------------------------------------------------------------
# Platform-Specific Builds & Mobile/Console Exports
# --------------------------------------------------------------------
Architectures/
ActiveX/
Debug/
Release/
Profile/
Test/

# --------------------------------------------------------------------
# Package & Cooking Outputs
# --------------------------------------------------------------------
# Ignore final packaged builds (usually created in root or custom folders)
*.apk
*.ipa
*.exe
Builds/
_Packaged/

# --------------------------------------------------------------------
# Whitelist rules (Ensure critical blueprint/source configs are kept)
# --------------------------------------------------------------------
!Config/Default*.ini
!Source/**/*

**/Binaries/
**/Build/
**/Intermediate/
**/Saved/
**/DerivedDataCache/
